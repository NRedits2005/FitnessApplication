<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_pull_up" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#006780" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#006948" stop-opacity="0.22" />
    </linearGradient>
    <radialGradient id="glow_pull_up" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#76dcff" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#76dcff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <!-- Background Card Canvas -->
  <rect width="480" height="360" rx="20" fill="#f3f4f5" />
  <rect width="480" height="360" rx="20" fill="url(#grad_pull_up)" />
  <circle cx="240" cy="180" r="130" fill="url(#glow_pull_up)" />
  
  <!-- Grid Accent Lines -->
  <line x1="40" y1="180" x2="440" y2="180" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />
  <line x1="240" y1="40" x2="240" y2="320" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />

  <!-- Exercise Artwork -->
  
            <!-- Overhead Bar -->
            <line x1="110" y1="80" x2="370" y2="80" stroke="#bccac0" stroke-width="10" stroke-linecap="round" />
            <!-- Head cleared above or near bar -->
            <circle cx="240" cy="95" r="18" fill="#e1e3e4" />
            <!-- V-Taper Torso -->
            <path d="M 240 115 L 240 210" stroke="#191c1d" stroke-width="26" stroke-linecap="round" />
            <!-- Arms bent at elbows -->
            <path d="M 170 80 L 195 125 L 230 125" fill="none" stroke="#76dcff" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M 310 80 L 285 125 L 250 125" fill="none" stroke="#76dcff" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
            <!-- Legs hanging -->
            <path d="M 240 210 L 235 290" stroke="#006780" stroke-width="16" stroke-linecap="round" />
            <path d="M 240 210 L 255 285" stroke="#006780" stroke-width="16" stroke-linecap="round" />
        

  <!-- Badge / Tag -->
  <g transform="translate(24, 24)">
    <rect width="130" height="32" rx="16" fill="#ffffff" filter="drop-shadow(0px 2px 8px rgba(0,0,0,0.08))" />
    <text x="65" y="21" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#006780" text-anchor="middle">Lats</text>
  </g>
</svg>