<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_bicep_curl" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#006780" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#00855d" stop-opacity="0.22" />
    </linearGradient>
    <radialGradient id="glow_bicep_curl" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#76dcff" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#76dcff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <!-- Background Card Canvas -->
  <rect width="480" height="360" rx="20" fill="#f3f4f5" />
  <rect width="480" height="360" rx="20" fill="url(#grad_bicep_curl)" />
  <circle cx="240" cy="180" r="130" fill="url(#glow_bicep_curl)" />
  
  <!-- Grid Accent Lines -->
  <line x1="40" y1="180" x2="440" y2="180" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />
  <line x1="240" y1="40" x2="240" y2="320" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />

  <!-- Exercise Artwork -->
  
            <!-- Head & Torso -->
            <circle cx="240" cy="115" r="18" fill="#e1e3e4" />
            <path d="M 240 135 L 240 240" stroke="#191c1d" stroke-width="26" stroke-linecap="round" />
            <!-- Left Arm Hanging, Right Arm Curled -->
            <path d="M 220 150 L 195 210 L 195 240" fill="none" stroke="#525d6c" stroke-width="12" stroke-linecap="round" />
            <path d="M 260 150 L 290 200 L 270 165" fill="none" stroke="#76dcff" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
            <!-- Dumbbell at contraction -->
            <circle cx="270" cy="160" r="14" fill="#006780" />
            <circle cx="195" cy="245" r="12" fill="#525d6c" />
        

  <!-- Badge / Tag -->
  <g transform="translate(24, 24)">
    <rect width="130" height="32" rx="16" fill="#ffffff" filter="drop-shadow(0px 2px 8px rgba(0,0,0,0.08))" />
    <text x="65" y="21" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#006780" text-anchor="middle">Biceps Brachii</text>
  </g>
</svg>