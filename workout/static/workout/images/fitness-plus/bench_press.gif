<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_bench_press" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#006948" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#00855d" stop-opacity="0.22" />
    </linearGradient>
    <radialGradient id="glow_bench_press" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#85f8c4" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#85f8c4" stop-opacity="0" />
    </radialGradient>
  </defs>
  <!-- Background Card Canvas -->
  <rect width="480" height="360" rx="20" fill="#f3f4f5" />
  <rect width="480" height="360" rx="20" fill="url(#grad_bench_press)" />
  <circle cx="240" cy="180" r="130" fill="url(#glow_bench_press)" />
  
  <!-- Grid Accent Lines -->
  <line x1="40" y1="180" x2="440" y2="180" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />
  <line x1="240" y1="40" x2="240" y2="320" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />

  <!-- Exercise Artwork -->
  
            <!-- Bench -->
            <rect x="140" y="240" width="200" height="20" rx="6" fill="#525d6c" />
            <rect x="180" y="260" width="16" height="60" fill="#3d4756" />
            <rect x="284" y="260" width="16" height="60" fill="#3d4756" />
            <!-- Person -->
            <ellipse cx="240" cy="225" rx="55" ry="18" fill="#191c1d" />
            <circle cx="170" cy="225" r="16" fill="#e1e3e4" />
            <!-- Barbell & Weights -->
            <line x1="160" y1="160" x2="320" y2="160" stroke="#85f8c4" stroke-width="8" stroke-linecap="round" />
            <rect x="150" y="135" width="14" height="50" rx="3" fill="#00855d" />
            <rect x="316" y="135" width="14" height="50" rx="3" fill="#00855d" />
            <!-- Arms holding bar -->
            <path d="M 210 225 L 215 165" stroke="#191c1d" stroke-width="12" stroke-linecap="round" />
            <path d="M 270 225 L 265 165" stroke="#191c1d" stroke-width="12" stroke-linecap="round" />
        

  <!-- Badge / Tag -->
  <g transform="translate(24, 24)">
    <rect width="130" height="32" rx="16" fill="#ffffff" filter="drop-shadow(0px 2px 8px rgba(0,0,0,0.08))" />
    <text x="65" y="21" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#006948" text-anchor="middle">Chest</text>
  </g>
</svg>