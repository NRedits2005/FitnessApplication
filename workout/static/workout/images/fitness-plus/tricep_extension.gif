<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_tricep_extension" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#525d6c" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#006948" stop-opacity="0.22" />
    </linearGradient>
    <radialGradient id="glow_tricep_extension" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#85f8c4" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#85f8c4" stop-opacity="0" />
    </radialGradient>
  </defs>
  <!-- Background Card Canvas -->
  <rect width="480" height="360" rx="20" fill="#f3f4f5" />
  <rect width="480" height="360" rx="20" fill="url(#grad_tricep_extension)" />
  <circle cx="240" cy="180" r="130" fill="url(#glow_tricep_extension)" />
  
  <!-- Grid Accent Lines -->
  <line x1="40" y1="180" x2="440" y2="180" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />
  <line x1="240" y1="40" x2="240" y2="320" stroke="#bccac0" stroke-width="1" stroke-dasharray="6,6" opacity="0.4" />

  <!-- Exercise Artwork -->
  
            <circle cx="230" cy="140" r="18" fill="#e1e3e4" />
            <path d="M 230 160 L 230 270" stroke="#191c1d" stroke-width="26" stroke-linecap="round" />
            <!-- Arms raised overhead with elbow bent back -->
            <path d="M 230 160 L 245 100 L 270 130" fill="none" stroke="#85f8c4" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
            <!-- Dumbbell behind head -->
            <rect x="260" y="125" width="24" height="30" rx="6" fill="#00855d" />
        

  <!-- Badge / Tag -->
  <g transform="translate(24, 24)">
    <rect width="130" height="32" rx="16" fill="#ffffff" filter="drop-shadow(0px 2px 8px rgba(0,0,0,0.08))" />
    <text x="65" y="21" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#525d6c" text-anchor="middle">Triceps Brachii</text>
  </g>
</svg>